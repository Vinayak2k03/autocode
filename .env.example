# ---------------------------------------------------------------------------
# Autocode environment variables — copy to .env.local and fill in real values.
# Never commit real values. See README.md for the full variable table.
# ---------------------------------------------------------------------------

# Public base URL of the app. Used for auth redirects (email links, sign-out).
# Dev: http://localhost:3000   Prod: https://your-domain.example
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project URL — from Supabase Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable (anon-safe) key — from the same API settings page.
# This key is safe to expose to the browser; do NOT use a service_role key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxx

# Runtime database URL used by Prisma (server-only).
# Supabase pooled connection (Supavisor, transaction mode, port 6543):
#   postgresql://postgres.<ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres.REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct database URL used by Prisma CLI for migrations (server-only).
# Free-tier Supabase direct host (db.<ref>.supabase.co:5432) is IPv6-only;
# use the Session pooler (port 5432 on the pooler host) if your network is IPv4:
#   postgresql://postgres.<ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres.REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
